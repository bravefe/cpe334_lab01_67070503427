// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())

  tickets Ticket[]
}

model Priority {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  createdAt          DateTime @default(now())
  requestedTickets   Ticket[] @relation("RequestedPriority")
  prioritizedTickets Ticket[] @relation("ItPriority")
}

model Status {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Employee {
  id               Int               @id @default(autoincrement())
  code             String            @unique
  name             String
  createdAt        DateTime          @default(now())
  ownedTickets     Ticket[]          @relation("TicketOwner")
  publicComments   PublicComment[]
  internalComments InternalComment[]
  attachments      Attachment[]
  serviceActions   ServiceAction[]
  eventLogs        EventLog[]
}

model Ticket {
  id                  Int               @id @default(autoincrement())
  code                String            @unique
  createdAt           DateTime          @default(now())
  summary             String
  description         String
  resolutionSummary   String?
  categoryId          Int
  requestedPriorityId Int
  itPriorityId        Int
  currentStatusId     Int
  ticketOwnerId       Int
  updatedAt           DateTime          @updatedAt

  category          Category          @relation(fields: [categoryId], references: [id])
  requestedPriority Priority         @relation("RequestedPriority", fields: [requestedPriorityId], references: [id])
  itPriority        Priority         @relation("ItPriority", fields: [itPriorityId], references: [id])
  currentStatus     Status            @relation(fields: [currentStatusId], references: [id])
  ticketOwner       Employee          @relation("TicketOwner", fields: [ticketOwnerId], references: [id])
  publicComments    PublicComment[]
  internalComments  InternalComment[]
  attachments       Attachment[]
  serviceActions    ServiceAction[]
  eventLogs         EventLog[]
}

model PublicComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  createdAt DateTime @default(now())
  ownerId   Int
  message   String

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [ownerId], references: [id])
}

model InternalComment {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  createdAt DateTime @default(now())
  ownerId   Int
  message   String

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [ownerId], references: [id])
}

model Attachment {
  id            Int      @id @default(autoincrement())
  ticketId      Int
  createdAt     DateTime @default(now())
  ownerId       Int
  fileName      String
  fileUrl       String
  fileType      String
  fileSizeBytes Int

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [ownerId], references: [id])
}

model ServiceAction {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  createdAt DateTime @default(now())
  ownerId   Int
  message   String

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [ownerId], references: [id])
}

model EventLog {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  createdAt DateTime @default(now())
  ownerId   Int
  message   String

  ticket Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  owner  Employee @relation(fields: [ownerId], references: [id])
}
